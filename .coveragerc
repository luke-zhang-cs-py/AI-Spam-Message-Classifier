[run]
# Branches as well as lines: a line can run on every test while one side of
# the `if` on it never does, and line coverage alone calls that 100%.
branch = True

# The tests only. Without this the test files counted as covered source and
# padded the total: 79% reported against 68% of the actual modules. Every
# other project in this family omits them, and a coverage figure that
# includes its own tests is measuring the wrong thing.
#
# tools/ used to be omitted as well, as developer scripts run by hand. That
# left three files -- the build that publishes docs/app, the script that
# rewrites the published figures, and the backend comparison -- holding nearly
# as many statements as the rest of the project together, tested by nothing.
# They are measured now, with the browser, the subprocesses and the encoder
# replaced by stand-ins in tests/test_tools_*.py.
#
# tools/__init__.py is what makes that hold for a script no test imports
# yet: coverage reports an unimported file at 0% only inside a package.
omit =
    tests/*

[report]
# 100% of lines and branches is required, by --cov-fail-under=100 in CI
# rather than fail_under here, so a run of one test file under --cov still
# reports instead of failing.
show_missing = True

# The one exclusion: the process entry points. Importing a module under test
# must not start a server or exit the interpreter, so the block cannot run in
# the suite by construction. Each block is a single call to a main() that is
# tested directly -- app.main(), classify.main() and the rest -- so what is
# excluded is that one line of process startup and nothing else.
#
# exclude_lines, which replaces coverage's default list, and not
# exclude_also, which adds to it. The defaults are `# pragma: no cover`, `...`
# stub bodies and `if TYPE_CHECKING:` blocks, so under exclude_also any of
# them would still take lines out of the 100% without anyone reading this
# file. Here a pragma is just a comment.
exclude_lines =
    if __name__ == .__main__.:

# Empty, for the same reason: the default is `# pragma: no branch`, which
# would still let one side of an `if` go untested. An empty list needs
# coverage 7.5.2 or later -- before that it marked every branch partial and
# hid them all -- which is why requirements.txt asks for it.
partial_branches =
