# Trained artifacts, regenerated by any run of the script.
# Pickled sklearn objects are version-brittle -- a .joblib saved by one
# scikit-learn release often refuses to load in another -- so committing
# them would ship a file that breaks on someone else's machine. Training
# takes under a second; just retrain.
spam_model.joblib
vectorizer.joblib
*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
